# 强制 shell 脚本使用 LF，防止 Windows 上 checkout 时被转成 CRLF 导致 CI 报
# "bad interpreter: No such file or directory"
gradlew text eol=lf
*.sh text eol=lf

# Gradle wrapper 二进制
gradle/wrapper/gradle-wrapper.jar binary

# 图片资源保持二进制
*.png binary
*.jpg binary
*.webp binary
*.ico binary

# 普通文本统一使用 LF
*.kt text eol=lf
*.kts text eol=lf
*.xml text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.toml text eol=lf
*.properties text eol=lf
*.pro text eol=lf
